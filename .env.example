# URL do backend (sem barra). Em produção na Vercel: Environment Variables com https://sua-api.onrender.com
# Vazio + VITE_USE_API_MOCK=false = proxy do Vite só em dev.
# Ou defina ex.: http://192.168.0.5:3000
VITE_API_URL=
# false = usar API real (proxy ou URL acima). true = mock offline.
VITE_USE_API_MOCK=false
